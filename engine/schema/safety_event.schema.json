{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icvsp.local/schema/safety_event.schema.json",
  "title": "Safety Event",
  "description": "One hazard observation as sent by a vehicle. Fields added by the platform (verification, trust weight, consensus) are not part of the message.",
  "type": "object",
  "required": ["event_id", "type", "timestamp", "location", "road_segment", "speed_kmh", "heading", "severity", "confidence", "source"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["pothole", "speed_bump"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "required": ["lat", "lon", "acc_m"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "acc_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "road_segment": { "type": "string", "minLength": 1 },
    "speed_kmh": { "type": "number", "minimum": 0 },
    "heading": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "severity": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "model": { "type": "string" }
  }
}
